var span = document.createElement('span');
span.style.color = 'var(--subtitle)';
span.textContent = txt;
li.appendChild(span);
effectsList.appendChild(li);
});
}
}

if (slider) {
slider.addEventListener('input', function () {
currentScore = parseInt(slider.value, 10);
render();
});
}

/* ---- Boutons d'actions ---- */
var actions = {
positive: [
{ label: 'Participer à une association', delta: 5 },
{ label: 'Aider un citoyen dans le besoin', delta: 4 },
{ label: 'Être apprécié par vos collègues', delta: 3 },
{ label: 'Dénoncer un comportement suspect aux autorités', delta: 8 },
{ label: 'Se porter volontaire pour une mission confiée par le Maire', delta: 10 },
{ label: 'Respecter scrupuleusement le couvre-feu', delta: 2 },
{ label: 'Faire un don à la ville', delta: 4 },
{ label: 'Réussir un entretien avec un représentant municipal', delta: 6 }
],
negative: [
{ label: 'Attaquer un autre citoyen', delta: -15 },
{ label: 'Ne pas vous rendre à un rendez-vous administratif', delta: -5 },
{ label: 'Tenter de vous échapper de la ville', delta: -25 },
{ label: 'Traîner avec des Obsidian si vous êtes Gold ou Platinum', delta: -8 },
{ label: 'Critiquer publiquement le Maire ou la ville', delta: -12 },
{ label: 'Être surpris en possession d\'objets interdits', delta: -10 },
{ label: 'Manquer de respect à un représentant de l\'autorité', delta: -7 },
{ label: 'Aider un Obsidian recherché par les autorités', delta: -20 }
]
};

function buildButtons(list, wrap, cls) {
if (!wrap) return;
var iconClass = cls === 'positive' ? 'fa-arrow-up' : 'fa-arrow-down';
list.forEach(function (a) {
var row = document.createElement('div');
row.className = 'gbsimbtn ' + cls;
row.innerHTML = '<em class="fa-solid ' + iconClass + ' gbsimicon"></em><span>' + a.label + '</span>';
wrap.appendChild(row);
});
}
buildButtons(actions.positive, document.getElementById('gbsimpositive'), 'positive');
buildButtons(actions.negative, document.getElementById('gbsimnegative'), 'negative');

/* ---- Détail complet par rang ---- */
var detailWrap = document.getElementById('gbrankdetails');
if (detailWrap) {
ranks.forEach(function (r, i) {
var det = document.createElement('details');
det.className = 'gbrankdetail';
var summary = document.createElement('summary');
summary.innerHTML = '<span class="gbrankdot" style="background:' + r.color + '"></span><span>' + r.name + ' : ' + r.min + '–' + r.max + '%</span>';
var content = document.createElement('div');
content.className = 'gbrankdetail-content';
var ul = document.createElement('ul');
r.full.forEach(function (txt) {
var li = document.createElement('li');
li.textContent = txt;
ul.appendChild(li);
});
content.appendChild(ul);
det.appendChild(summary);
det.appendChild(content);
detailWrap.appendChild(det);
});
}

render();

});
</script>

<!-- ==== Quiz d'affinité citoyenne ==== -->
<script>
document.addEventListener('DOMContentLoaded', function () {

var quizRoot = document.getElementById('gbquiz');
if (!quizRoot) return;

var quizGroups = {
loyalistes: { name: 'Loyalistes', color: '#1F7A5C', text: 'Vous croyez en la ville, en son ordre, en la place qu\'elle vous a donnée. Vous jouez le jeu du Maire avec sérieux, convaincu que la réussite se mérite. La structure ne vous pèse pas : elle vous rassure.' },
detracteurs: { name: 'Détracteurs', color: '#B23A48', text: 'Vous n\'avez jamais accepté Shinsei City comme un foyer. Derrière une façade de conformité ou une résistance ouverte, vous cherchez la faille du système, et un moyen d\'y échapper.' },
indifferents: { name: 'Indifférents', color: '#4A6A7A', text: 'Vous n\'êtes ni pour ni contre. La ville existe, alors vous vivez avec, sans grand enthousiasme ni grande révolte. Vous avancez, pragmatique, en évitant les vagues.' },
fanatiques: { name: 'Fanatiques', color: '#6A4C93', text: 'Pour vous, Shinsei City dépasse la simple ville. C\'est un signe, un jugement, peut-être un destin. Vous interprétez chaque détail du système comme la part d\'un dessein plus grand.' }
};

var quizQuestions = [
{
text: 'Vous croisez un habitant de rang Obsidian visiblement en difficulté dans la rue. Vous...',
options: [
{ label: 'Signalez la situation aux autorités, par précaution.', group: 'loyalistes' },
{ label: 'Détournez le regard, ce n\'est pas votre problème.', group: 'indifferents' },
{ label: 'L\'aidez discrètement, quoi qu\'il en coûte à votre score.', group: 'detracteurs' },
{ label: 'Y voyez un signe, une leçon que la ville veut vous enseigner.', group: 'fanatiques' }
]
},
{
text: 'Votre score de fiabilité vient de baisser de plusieurs points sans explication claire. Vous...',
options: [
{ label: 'Redoublez d\'efforts pour le faire remonter au plus vite.', group: 'loyalistes' },
{ label: 'Haussez les épaules, ça remontera bien un jour.', group: 'indifferents' },
{ label: 'Enragez intérieurement contre un système que vous jugez arbitraire.', group: 'detracteurs' },
{ label: 'Interprétez cela comme une épreuve envoyée par le Maire.', group: 'fanatiques' }
]
},
{
text: 'On vous propose un poste au sein d\'un comité de surveillance de quartier. Vous...',
options: [
{ label: 'Acceptez avec enthousiasme, l\'occasion de prouver votre valeur.', group: 'loyalistes' },
{ label: 'Acceptez sans grand enthousiasme, ça fera l\'affaire.', group: 'indifferents' },
{ label: 'Refusez net, vous ne participerez jamais à ça.', group: 'detracteurs' },
{ label: 'Y voyez une opportunité de vous rapprocher du Maire.', group: 'fanatiques' }
]
},
{
text: 'Que pensez-vous réellement du Maire ?',
options: [
{ label: 'Un dirigeant compétent, à qui la ville doit beaucoup.', group: 'loyalistes' },
{ label: 'Une figure comme une autre, ni pire ni meilleure qu\'ailleurs.', group: 'indifferents' },
{ label: 'Un tyran déguisé en mascotte sympathique.', group: 'detracteurs' },
{ label: 'Une entité qui dépasse la simple notion de dirigeant.', group: 'fanatiques' }
]
},
{
text: 'Un ami vous propose un plan pour quitter la ville. Vous...',
options: [
{ label: 'Le dénoncez, ou du moins refusez fermement d\'y participer.', group: 'loyalistes' },
{ label: 'Déclinez poliment, la vie ici vous convient très bien.', group: 'indifferents' },
{ label: 'Envisagez sérieusement de le suivre.', group: 'detracteurs' },
{ label: 'Le prévenez que personne ne quitte Shinsei City sans l\'accord du Maire.', group: 'fanatiques' }
]
},
{
text: 'Si vous deviez résumer votre vie à Shinsei City en un mot, ce serait...',
options: [
{ label: '« Opportunité »', group: 'loyalistes' },
{ label: '« Quotidien »', group: 'indifferents' },
{ label: '« Cage »', group: 'detracteurs' },
{ label: '« Destin »', group: 'fanatiques' }
]
}
];

var introEl = document.getElementById('gbquizintro');
var progressWrap = document.getElementById('gbquizprogresswrap');
var progressBar = document.getElementById('gbquizprogressbar');
var questionEl = document.getElementById('gbquizquestion');
var qnumEl = document.getElementById('gbquizqnum');
var qtextEl = document.getElementById('gbquizqtext');
var optionsEl = document.getElementById('gbquizoptions');
var resultEl = document.getElementById('gbquizresult');
var resultDot = document.getElementById('gbquizresultdot');
var resultTitle = document.getElementById('gbquizresulttitle');
var resultText = document.getElementById('gbquizresulttext');
var startBtn = document.getElementById('gbquizstart');
var restartBtn = document.getElementById('gbquizrestart');

var currentIndex = 0;
var scores = {};

function resetQuiz() {
currentIndex = 0;
scores = { loyalistes: 0, detracteurs: 0, indifferents: 0, fanatiques: 0 };
}

function renderQuestion() {
var q = quizQuestions[currentIndex];
qnumEl.textContent = 'Question ' + (currentIndex + 1) + ' / ' + quizQuestions.length;
qtextEl.textContent = q.text;
optionsEl.innerHTML = '';
q.options.forEach(function (opt) {
var btn = document.createElement('button');
btn.type = 'button';
btn.className = 'gbquiz-option';
btn.textContent = opt.label;
btn.addEventListener('click', function () {
scores[opt.group]++;
currentIndex++;
if (currentIndex < quizQuestions.length) {
renderQuestion();
progressBar.style.width = (currentIndex / quizQuestions.length * 100) + '%';
} else {
showResult();
}
});
optionsEl.appendChild(btn);
});
}

function showResult() {
progressBar.style.width = '100%';
questionEl.hidden = true;
progressWrap.hidden = true;

var bestKey = 'loyalistes';
var bestScore = -1;
['loyalistes', 'detracteurs', 'indifferents', 'fanatiques'].forEach(function (key) {
if (scores[key] > bestScore) {
bestScore = scores[key];
bestKey = key;
}
});

var g = quizGroups[bestKey];
resultDot.style.setProperty('--result-color', g.color);
resultTitle.style.setProperty('--result-color', g.color);
resultTitle.textContent = g.name;
resultText.textContent = g.text;
resultEl.hidden = false;
}

startBtn.addEventListener('click', function () {
resetQuiz();
introEl.hidden = true;
progressWrap.hidden = false;
questionEl.hidden = false;
progressBar.style.width = '0%';
renderQuestion();
});

restartBtn.addEventListener('click', function () {
resultEl.hidden = true;
introEl.hidden = false;
});

});
</script>

</body>
</html>
