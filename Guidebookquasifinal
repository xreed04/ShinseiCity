<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guidebook - Shinsei City</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Electrolize&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
:root {
color-scheme: dark;
--accent1: #c94c4c;
--accent2: #7a3b3b;
--links1: #b5b5b5;
--links2: #ddd;
--scroll-thumb: var(--accent2);
--scroll-track: #0d0c10;
--body: #201f24;
--cuerpo: #0c0b0fce;
--dbckg0: #0e0d1280;
--dbckg1: #100f1480;
--dbckg2: #12111680;
--deco: #0d0c10;
--border1: 1px solid #16151a;
--border2: 1px solid color-mix(in srgb, var(--accent2) 50%, #0d0c10);
--fs-h1: 3.5rem;
--fs-h3: 2rem;
--fs-h4: 1.6rem;
--fs-h6: 1.25rem;
--fs-body: 1rem;
--fs-small: 0.85rem;
--fs-tiny: 0.75rem;
--f-body: "Lato", sans-serif;
--f-titles: "Electrolize", sans-serif;
--f-mono: "IBM Plex Mono", monospace;
--text: #8d8a92;
--text2: #6a6770;
--text3: #47454c;
--subtitle: #c3bfc9;
--title: #ece9ef;
--gap: 1rem;
--padding: 2rem;
--margin: 3rem;
--body-img: url(https://2img.net/i.imgur.com/Nl6O7zB.jpeg);
--body-effect: multiply;
}
html.light {
color-scheme: light;
--accent1: #af7853;
--accent2: #865438;
--links1: #5b4636;
--links2: #3a2c22;
--body: #f5ebe0;
--cuerpo: #f7efe680;
--dbckg0: #f2e8dd80;
--dbckg1: #efe2d580;
--dbckg2: #ecdccc80;
--deco: #edcdad;
--border1: 1px solid #d9bfa0;
--text: #6b5946;
--text2: #86735d;
--text3: #9c8b76;
--subtitle: #4a3b2c;
--title: #2c2115;
--body-effect: screen;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; min-height: 100%; font: var(--fs-body) var(--f-body); scroll-behavior: smooth; }
body {
background-color: var(--body);
background-image: var(--body-img);
background-blend-mode: var(--body-effect, multiply);
background-size: cover;
background-position: center;
background-attachment: fixed;
background-repeat: no-repeat;
color: var(--text);
padding: var(--margin) 0;
position: relative;
}
body::before {
content: '';
position: fixed;
inset: 0;
z-index: -1;
background: var(--body-overlay, transparent);
pointer-events: none;
}
html.light body::before { --body-overlay: rgba(255, 255, 255, 0.35); }
a { color: var(--links1); text-decoration: none; transition: ease .3s; }
a:hover { color: var(--links2); }
*::-webkit-scrollbar { width: 6px; }
*::-webkit-scrollbar-track { background: var(--scroll-track); }
*::-webkit-scrollbar-thumb { background: var(--scroll-thumb); }

/* PAGE WRAP + RETOUR AU FORUM */
.gbpagewrap { width: clamp(20rem, 85dvw, 1302px); margin-inline: auto; }
.gbback {
display: inline-flex; align-items: center; gap: .6em; margin-bottom: var(--gap);
font: 700 var(--fs-h6) var(--f-titles); text-transform: uppercase; letter-spacing: .02em;
background: linear-gradient(to right, var(--accent2), var(--accent1));
-webkit-background-clip: text; background-clip: text; color: transparent;
}
.gbback em { color: var(--accent1); -webkit-text-fill-color: var(--accent1); }
.gbback:hover { filter: brightness(1.25); }

/* GUIDEBOOK - STRUCTURE GENERALE */
#guidebook { margin-bottom: var(--margin); }
.gbenv {
display: flex; align-items: stretch; overflow: hidden;
border: var(--border2); outline: var(--border1); outline-offset: -1px;
background: var(--cuerpo); backdrop-filter: blur(8px);
min-height: 32rem; max-height: calc(100dvh - 6rem);
position: relative;
}
.gbenv::before {
content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
background: linear-gradient(to right, var(--accent2), var(--accent1), var(--accent2)); z-index: 3;
}
.gbenv::after {
content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 4;
background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,.35) 100%);
}

/* MENU LATERAL */
.gbside { width: 17rem; flex-shrink: 0; background: var(--dbckg1); border-right: var(--border1); padding: var(--gap) 0; overflow-y: auto; min-height: 0; }
.gbcatlist { list-style: none; margin: 0; padding: 0; }
.gbcat-item { border-bottom: var(--border1); }
.gbcat-toggle {
width: 100%; display: flex; align-items: center; gap: .7em; background: transparent; border: 0;
padding: 1em 1.25em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase;
letter-spacing: .03em; color: var(--subtitle); cursor: pointer; text-align: left; transition: ease .3s;
}
.gbcat-toggle > em { color: var(--accent1); font-size: var(--fs-h6); flex-shrink: 0; transition: ease .3s; }
.gbcat-toggle:hover > em { color: #e0b060; font-size: calc(var(--fs-h6) * 1.2); filter: drop-shadow(0 0 6px rgba(224,176,96,.4)); }
.gbcat-toggle > span { flex-grow: 1; }
.gbcat-toggle:hover { color: var(--links2); }
.gbchevron::before {
content: '\f078'; font-family: 'Font Awesome 6 Free'; font-weight: 900; font-size: var(--fs-tiny);
color: var(--text3); transition: transform .3s ease; display: inline-block;
}
.gbcat-item.open .gbchevron::before { transform: rotate(180deg); color: var(--accent1); }
.gbsublist { list-style: none; margin: 0; padding: 0; max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.gbcat-item.open .gbsublist { max-height: 40rem; }
.gblink { display: block; padding: .6em 1.25em .6em 3em; font: var(--fs-small) var(--f-body); color: var(--text); border-left: 2px solid transparent; transition: ease .25s; }
.gblink:hover { color: var(--links2); background: var(--dbckg2); }
.gblink.active { color: var(--accent1); background: var(--dbckg2); border-left-color: var(--accent1); font-weight: 700; }

/* ZONE DE CONTENU */
.gbmain { flex-grow: 1; min-width: 0; min-height: 0; padding: calc(var(--padding) * 1.5); overflow-y: auto; position: relative; }
.gbpage { display: none; }
.gbpage.active { display: block; animation: gbfade .35s ease; }
@keyframes gbfade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* Bloc d'outils en haut du menu (thème + filtre) */
.gbsidetools { padding: .9em 1.25em 1.1em; border-bottom: var(--border1); display: flex; flex-direction: column; gap: .9em; }
#theme-switcher {
display: flex; align-items: center; gap: .7em; width: 100%; box-sizing: border-box;
background: transparent; border: var(--border1); border-radius: 6px; padding: .6em .9em;
color: var(--text2); font: var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .04em;
cursor: pointer; transition: ease .3s;
}
#theme-switcher em { font-size: 1rem; }
#theme-switcher:hover { color: var(--accent1); border-color: var(--accent2); }
.icon-light { display: none; }
html.light .icon-dark { display: none; }
html.light .icon-light { display: inline; }

.gbbreadcrumb {
position: static;
background: var(--cuerpo); backdrop-filter: blur(8px);
font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--text3);
padding: .85em calc(var(--padding) * 1.5); margin: 0 calc(var(--padding) * -1.5) 1.5em;
border-bottom: var(--border1);
}
.gbbreadcrumb em { margin: 0 .6em; font-size: .65em; color: var(--accent2); }
.gbbreadcrumb .gbcrumb-current { color: var(--accent1); }

/* Barre de progression de lecture */
.gbprogress { position: static; height: 3px; width: 100%; margin: 0 calc(var(--padding) * -1.5); background: var(--dbckg2); }
.gbprogress-bar { height: 100%; width: 0%; background: linear-gradient(to right, var(--accent2), var(--accent1)); transition: width .1s linear; }

.gbbanner { position: relative; margin: 0 calc(var(--padding) * -1.5) 1.5em; overflow: hidden; line-height: 0; }
.gbbanner img { display: block; width: 100%; height: auto; position: relative; z-index: 0; filter: saturate(.9) contrast(1.05); }
.gbbanner::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(0,0,0,.9) 0%, rgba(0,0,0,.55) 25%, rgba(0,0,0,.15) 50%, transparent 70%); }
.gbbanner .gbheader { position: absolute; z-index: 2; bottom: 0; left: 0; right: 0; margin: 0; padding: 1.25em calc(var(--padding) * 1.5) 1.1em; border-bottom: 0; }
.gbbanner .gbheader h2 { color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,.6); }
.gbbanner .gbheader em { filter: drop-shadow(0 2px 6px rgba(0,0,0,.5)); }

.gbheader { display: flex; align-items: center; gap: .6em; border-bottom: var(--border2); padding-bottom: .85em; margin-bottom: 1.5em; }
.gbheader > em { color: var(--accent1); font-size: var(--fs-h4); flex-shrink: 0; }
.gbheader > h2 { margin: 0; font: var(--fs-h3) var(--f-titles); text-transform: uppercase; color: var(--title); line-height: 1em; }

.gbintro { border: var(--border1); border-left: 3px solid var(--accent1); background: var(--dbckg0); padding: 1em 1.5em; font: var(--fs-small) var(--f-body); color: var(--subtitle); margin-bottom: 2em; line-height: 1.5em; }

.gbbody { display: flex; align-items: flex-start; gap: calc(var(--gap) * 2); }
.gbsommaire { width: 12rem; flex-shrink: 0; position: sticky; top: 1em; background: var(--dbckg0); border: var(--border1); border-radius: 4px; padding: 1.2em 1.1em; }
.gbsommaire h3 { font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; color: var(--accent1); margin: 0 0 .75em; line-height: 1em; padding-bottom: .6em; border-bottom: var(--border1); }
.gbsommaire a { display: flex; align-items: center; gap: .5em; padding: .5em .4em; margin: 0 -.4em; border-radius: 3px; font: var(--fs-tiny) var(--f-body); color: var(--text2); transition: ease .25s; }
.gbsommaire a::before { content: '\f105'; font-family: 'Font Awesome 6 Free'; font-weight: 900; font-size: .75em; color: var(--accent2); transition: ease .25s; }
.gbsommaire a:hover { background: var(--dbckg2); color: var(--links2); padding-left: .7em; }
.gbsommaire a:hover::before { color: var(--accent1); transform: translateX(2px); }
.gbsommaire a.active { background: var(--dbckg2); color: var(--accent1); padding-left: .7em; }
.gbsommaire a.active::before { color: var(--accent1); transform: translateX(2px); }
.gbsommaire-group { display: block; margin: 1.1em 0 .4em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--text3); padding-bottom: .3em; border-bottom: var(--border1); }
.gbsommaire-group:first-of-type { margin-top: 0; }

.gbreadtime { margin-left: 1em; color: var(--text3); }
.gbreadtime em { margin-right: .35em; color: var(--text3); font-size: .9em; }

/* Note du Maire */
.gbnote {
position: relative; background: var(--dbckg1); border: var(--border2); border-radius: 20px;
padding: 1.6em 1.8em 1.6em 7rem; margin: 2.2em 0 1.5em;
}
.gbnote-avatar { position: absolute; top: -1.2em; left: -1em; width: 6rem; height: 6rem; z-index: 1; }
.gbnote-avatar-img {
width: 100%; height: 100%; border-radius: 14px; overflow: hidden;
border: 3px solid var(--accent2); box-shadow: 0 6px 14px rgba(0,0,0,.4); transform: rotate(-4deg);
}
.gbnote-avatar-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gbnote-clip {
position: absolute; top: -1.1em; left: 1.2em; font-size: 2rem; color: #ddd;
transform: rotate(-20deg); text-shadow: 0 2px 4px rgba(0,0,0,.5); z-index: 2;
}
.gbnote-text { font: var(--fs-body) var(--f-body); line-height: 1.65em; color: var(--text); text-align: justify; }
.gbnote-text strong { color: var(--accent1); }
.gbnote-highlight { color: #e0b060; font-weight: 700; }

/* ===== Fil de commentaires (le Maire commente la page) ===== */
.gbcomments { margin: 3em 0 0; padding-top: 1.8em; border-top: var(--border1); }
.gbcomments-label {
display: flex; align-items: center; gap: .6em; margin-bottom: 1.4em;
font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--text3);
}
.gbcomments-label em { color: var(--accent2); }

.gbcomment { position: relative; display: flex; gap: 1em; }
.gbcomment + .gbcomment { margin-top: 1.3em; }
.gbcomment-thread { position: relative; }
.gbcomment-avatar {
width: 2.8rem; height: 2.8rem; border-radius: 50%; overflow: hidden; flex-shrink: 0;
border: 2px solid var(--accent2); background: var(--dbckg0); z-index: 1;
}
.gbcomment-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gbcomment-body { flex-grow: 1; min-width: 0; background: var(--dbckg1); border: var(--border1); border-radius: 14px; padding: 1em 1.3em; }
.gbcomment-head { display: flex; align-items: baseline; gap: .6em; margin-bottom: .5em; flex-wrap: wrap; }
.gbcomment-author { font: 700 var(--fs-small) var(--f-titles); color: var(--accent1); }
.gbcomment-author em { font-style: normal; color: var(--text2); font-weight: 400; }
.gbcomment-time { font: var(--fs-tiny) var(--f-mono); color: var(--text3); }
.gbcomment-text { font: var(--fs-small) var(--f-body); color: var(--text); line-height: 1.6em; text-align: left; }
.gbcomment-text p { margin: 0 0 .8em; }
.gbcomment-text p:last-child { margin-bottom: 0; }
.gbcomment-text em.gbcomment-italic { font-style: italic; color: var(--subtitle); }
.gbcomment-votes {
display: inline-flex; align-items: center; gap: .5em; margin-top: .8em; padding: .3em .7em;
border: var(--border1); border-radius: 20px; background: var(--dbckg0); font: 700 var(--fs-tiny) var(--f-mono); color: var(--text2);
}
.gbcomment-votes em { color: var(--accent1); cursor: default; }

/* Réponses imbriquées, reliées par un trait */
.gbcomment-replies { position: relative; margin-top: 1em; padding-left: 2.3em; }
.gbcomment-replies::before {
content: ''; position: absolute; top: -1em; left: 1.35rem; bottom: 1.4rem; width: 2px;
background: linear-gradient(to bottom, var(--accent2), transparent 95%); opacity: .6;
}
.gbcomment-replies .gbcomment { position: relative; }
.gbcomment-replies .gbcomment::before {
content: ''; position: absolute; top: 1.4rem; left: -1.15em; width: 1.15em; height: 2px;
background: var(--accent2); opacity: .6;
}
.gbcomment-replies .gbcomment-avatar { width: 2.2rem; height: 2.2rem; }
.gbcomment-replies .gbcomment + .gbcomment { margin-top: 1em; }

/* Liste à puces stylisée */
.gbtext ul.gblist { list-style: none; margin: 0 0 1.5em; padding: 0; display: flex; flex-direction: column; gap: .55em; }
.gbtext ul.gblist li { position: relative; padding-left: 1.5em; }
.gbtext ul.gblist li::before { content: '\f105'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; left: 0; top: .15em; color: var(--accent1); font-size: .85em; }

/* Bloc verrouillé par mot de passe */
.gblocked { margin: 1.5em 0; border: 1px dashed var(--accent2); background: var(--dbckg1); padding: 1.5em 1.75em; }
.gblocked-form { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .75em; }
.gblocked-form > em { font-size: 1.8rem; color: var(--accent2); }
.gblocked-form p { margin: 0; font: var(--fs-small) var(--f-body); color: var(--text2); }
.gblocked-inputrow { display: flex; gap: .6em; width: 100%; max-width: 22rem; }
.gblocked-input { flex-grow: 1; background: var(--dbckg0); border: var(--border1); color: var(--text); padding: .6em .8em; font: var(--fs-small) var(--f-body); }
.gblocked-input:focus { outline: none; border-color: var(--accent2); }
.gblocked-submit { background: transparent; border: 1px solid var(--accent1); color: var(--accent1); padding: .6em 1.1em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; cursor: pointer; transition: ease .3s; }
.gblocked-submit:hover { background: var(--accent1); color: var(--dbckg0); }
.gblocked-error { color: var(--accent1) !important; font: var(--fs-tiny) var(--f-mono) !important; text-transform: uppercase; }
.gblocked-content { font: var(--fs-body) var(--f-body); line-height: 1.65em; color: var(--text); text-align: justify; }

.gbtext { flex-grow: 1; min-width: 0; font: var(--fs-body) var(--f-body); line-height: 1.65em; color: var(--text); text-align: justify; }
.gbtext h3 { font: 700 var(--fs-h6) var(--f-titles); color: var(--subtitle); text-transform: uppercase; margin: 1.5em 0 .6em; line-height: 1em; }
.gbtext h3:first-child { margin-top: 0; }
.gbtext p { margin: 0 0 1em; }
.gbtext strong { color: var(--accent1); }

.gbcallout { border: var(--border1); background: var(--dbckg1); padding: 1em 1.5em; margin: 1.5em 0; }
.gbcallout h4 { margin: 0 0 .5em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; color: var(--accent1); line-height: 1em; }
.gbcallout p { margin: 0; font: var(--fs-small) var(--f-body); color: var(--subtitle); }

.gbpending { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 1em; padding: 4em 2em; border: 1px dashed #16151a; color: var(--text2); }
.gbpending em { font-size: 2.2rem; color: var(--accent2); }
.gbpending p { margin: 0; font: italic var(--fs-small) var(--f-body); text-transform: uppercase; letter-spacing: .04em; max-width: 24rem; }

/* Effet glitch au survol des titres */
.gbheader h2 { transition: text-shadow .2s; }
.gbheader h2:hover { animation: gbglitch .3s steps(2, end) infinite; }
@keyframes gbglitch {
0% { text-shadow: 2px 0 var(--accent1), -2px 0 #5fd3ff; }
25% { text-shadow: -2px 0 var(--accent1), 2px 0 #5fd3ff; }
50% { text-shadow: 2px 1px var(--accent1), -2px -1px #5fd3ff; }
75% { text-shadow: -1px 2px var(--accent1), 1px -2px #5fd3ff; }
100% { text-shadow: 2px 0 var(--accent1), -2px 0 #5fd3ff; }
}

/* Tags de page */
.gbtag { display: inline-block; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; padding: .3em .7em; border-radius: 3px; margin-left: .75em; vertical-align: middle; }
.gbtag-important { background: rgba(201,76,76,.15); color: var(--accent1); border: 1px solid var(--accent1); }
.gbtag-update { background: rgba(143,179,217,.15); color: #8fb3d9; border: 1px solid #8fb3d9; }
.gbtag-spoiler { background: rgba(122,59,59,.25); color: var(--accent2); border: 1px solid var(--accent2); }

/* Tableaux de données */
.gbtext table { width: 100%; border-collapse: collapse; margin: 1.5em 0; font: var(--fs-small) var(--f-body); }
.gbtext th, .gbtext td { border: var(--border1); padding: .6em .9em; text-align: left; }
.gbtext th { background: var(--dbckg1); color: var(--accent1); text-transform: uppercase; font: 700 var(--fs-tiny) var(--f-titles); letter-spacing: .05em; }
.gbtext tr:nth-child(even) td { background: var(--dbckg0); }

/* Citation style journal / rapport */
.gbquote { position: relative; margin: 1.5em 0; padding: 1.2em 1.5em 1.2em 3em; border-left: 3px solid var(--accent2); background: var(--dbckg0); font: italic var(--fs-small) var(--f-body); color: var(--subtitle); }
.gbquote::before { content: '\f10d'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; left: 1em; top: 1.1em; color: var(--accent2); font-size: 1.1em; opacity: .6; }
.gbquote cite { display: block; margin-top: .75em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--text3); font-style: normal; }

/* Encart "classifié" — utilise <details>/<summary>, aucun JS requis */
.gbclassified { margin: 1.5em 0; }
.gbclassified summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: .6em; padding: .8em 1.1em; background: var(--dbckg1); border: 1px dashed var(--accent2); color: var(--text2); font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; }
.gbclassified summary::-webkit-details-marker { display: none; }
.gbclassified summary::before { content: '\f023'; font-family: 'Font Awesome 6 Free'; font-weight: 900; color: var(--accent2); }
.gbclassified[open] summary::before { content: '\f09c'; }
.gbclassified-content { padding: 1.1em 1.5em; border: 1px dashed var(--accent2); border-top: 0; background: var(--dbckg0); font: var(--fs-small) var(--f-body); color: var(--subtitle); line-height: 1.6em; }

/* Spoiler générique — pour englober un bloc de contenu structuré (grilles, boutons, etc.) */
.gbspoiler { margin: 1.5em 0; border: var(--border2); border-radius: 10px; background: var(--dbckg1); overflow: hidden; }
.gbspoiler summary {
list-style: none; cursor: pointer; display: flex; align-items: center; gap: .7em;
padding: 1em 1.4em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase;
letter-spacing: .04em; color: var(--subtitle); transition: ease .25s;
}
.gbspoiler summary:hover { color: var(--links2); background: var(--dbckg2); }
.gbspoiler summary::-webkit-details-marker { display: none; }
.gbspoiler summary .gbspoiler-icon { color: var(--accent1); font-size: 1em; flex-shrink: 0; transition: transform .3s ease; }
.gbspoiler[open] summary .gbspoiler-icon { transform: rotate(180deg); }
.gbspoiler summary .gbspoiler-hint { margin-left: auto; font: var(--fs-tiny) var(--f-mono); text-transform: none; letter-spacing: .02em; color: var(--text3); }
.gbspoiler[open] summary .gbspoiler-hint { display: none; }
.gbspoiler-body { padding: 0 1.4em 1.6em; border-top: var(--border1); padding-top: 1.4em; animation: gbspoileropen .35s ease; }
@keyframes gbspoileropen { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

/* Effet scanline/CRT — uniquement sur la bannière */
.gbbanner::after {
content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none;
background: repeating-linear-gradient(to bottom, rgba(0,0,0,.25) 0px, rgba(0,0,0,.25) 1px, transparent 1px, transparent 3px);
opacity: .5;
}

/* Tampon d'encre officiel */
.gbintro { position: relative; }
.gbstamp {
position: absolute; top: -1em; right: 1.5em;
border: 3px solid var(--accent1); border-radius: 6px; color: var(--accent1);
font: 900 var(--fs-small) var(--f-mono); text-transform: uppercase; letter-spacing: .15em;
padding: .35em .8em; transform: rotate(-8deg); opacity: .8; background: var(--cuerpo);
}

/* Numérotation type dossier */
.gbdocnum { font: 700 var(--fs-tiny) var(--f-mono); letter-spacing: .1em; color: var(--title); text-transform: uppercase; margin-left: auto; }

/* Lexique avec infobulle */
.gblex { position: relative; border-bottom: 1px dotted var(--accent2); cursor: help; color: var(--subtitle); }
.gblex::after {
content: attr(data-def); position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);
background: var(--deco); border: var(--border1); color: var(--text);
font: var(--fs-tiny) var(--f-body); font-style: normal; text-align: left;
padding: .6em .8em; width: max-content; max-width: 16rem;
opacity: 0; pointer-events: none; transition: opacity .2s ease; z-index: 20; line-height: 1.4em;
}
.gblex:hover::after { opacity: 1; }

/* Bouton retour en haut */
.gbscrolltop {
position: absolute; bottom: 1.5rem; right: 1.5rem; width: 2.6rem; height: 2.6rem; border-radius: 50%;
display: flex; align-items: center; justify-content: center;
background: var(--deco); border: var(--border1); color: var(--text3); cursor: pointer;
opacity: 0; pointer-events: none; transform: translateY(10px); transition: ease .3s; z-index: 6;
}
.gbscrolltop.visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
.gbscrolltop:hover { color: var(--accent1); border-color: var(--accent2); }

/* Fiche technique (grille clé/valeur) */
.gbspecs { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1px; margin: 1.5em 0; background: #16151a; border: var(--border1); }
.gbspecs-item { background: var(--dbckg0); padding: .9em 1.1em; display: flex; flex-direction: column; gap: .3em; }
.gbspecs-label { font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--accent1); }
.gbspecs-value { font: var(--fs-small) var(--f-body); color: var(--subtitle); }

/* Image censurée révélable — <details>, aucun JS requis */
.gbcensored { margin: 1.5em 0; }
.gbcensored summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: .6em; padding: .8em 1.1em; background: var(--dbckg1); border: 1px dashed var(--accent2); color: var(--text2); font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; }
.gbcensored summary::-webkit-details-marker { display: none; }
.gbcensored summary::before { content: '\f030'; font-family: 'Font Awesome 6 Free'; font-weight: 900; color: var(--accent2); }
.gbcensored-content { border: 1px dashed var(--accent2); border-top: 0; overflow: hidden; }
.gbcensored-content img { width: 100%; display: block; }

/* FAQ en accordéon */
.gbfaq { display: flex; flex-direction: column; gap: .75em; }
.gbfaqitem summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1em; padding: .9em 1.2em; background: var(--dbckg1); border: var(--border1); font: 700 var(--fs-small) var(--f-titles); color: var(--subtitle); }
.gbfaqitem summary::-webkit-details-marker { display: none; }
.gbfaqitem summary::after { content: '\f078'; font-family: 'Font Awesome 6 Free'; font-weight: 900; font-size: var(--fs-tiny); color: var(--accent1); transition: transform .3s; }
.gbfaqitem[open] summary::after { transform: rotate(180deg); }
.gbfaqitem .gbfaqanswer { padding: 1em 1.2em; border: var(--border1); border-top: 0; font: var(--fs-small) var(--f-body); color: var(--text); line-height: 1.6em; }

/* Filtre par tag dans le menu */
.gbfilterbar { display: flex; align-items: center; gap: .6em; font: var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .03em; color: var(--text2); cursor: pointer; }
.gbfilterbar input[type="checkbox"] { accent-color: var(--accent1); cursor: pointer; }
.gbside.filter-important .gblink:not([data-tag~="important"]) { display: none; }
.gbside.filter-important .gbcat-item:not(:has(.gblink[data-tag~="important"])) { display: none; }

/* Effet machine à écrire */
.gbtyping::after { content: '▌'; margin-left: 2px; color: var(--accent1); animation: gbcursorblink 1s steps(1) infinite; }
@keyframes gbcursorblink { 50% { opacity: 0; } }

/* ===== Simulateur de score d'engagement ===== */
.gbscoreranks { display: flex; flex-wrap: wrap; gap: .6em; margin: 1.2em 0 1.8em; }
.gbrankchip { flex: 1 1 8rem; display: flex; flex-direction: column; align-items: center; gap: .3em; padding: .8em .6em; border-radius: 6px; border: var(--border1); background: var(--dbckg0); text-align: center; }
.gbrankchip .gbrankname { font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; letter-spacing: .03em; }
.gbrankchip .gbrankrange { font: var(--fs-tiny) var(--f-mono); color: var(--text2); }

.gbsimscore { border: var(--border2); background: var(--dbckg1); border-radius: 10px; padding: 1.6em 1.8em; margin: 1.8em 0; }
.gbsim-top { display: flex; align-items: center; justify-content: space-between; gap: 1.5em; flex-wrap: wrap; margin-bottom: 1em; }
.gbsim-readout { display: flex; align-items: baseline; gap: .35em; }
.gbsim-score-value { font: 900 var(--fs-h1) var(--f-titles); line-height: 1em; transition: color .25s ease; }
.gbsim-score-pct { font: 700 var(--fs-h6) var(--f-titles); color: var(--text2); }
.gbsim-badge { font: 700 var(--fs-small) var(--f-mono); text-transform: uppercase; letter-spacing: .08em; padding: .4em .9em; border-radius: 20px; border: 2px solid var(--text3); transition: color .25s ease, border-color .25s ease; }

/* Effet brillant sur le tag Gold / Platinum — même timing pour les deux */
.gbshine-gold, .gbshine-platinum {
position: relative;
overflow: hidden;
}
.gbshine-gold::after, .gbshine-platinum::after {
content: '';
position: absolute;
top: 0; left: -70%;
width: 55%; height: 100%;
background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.85) 50%, transparent 100%);
mix-blend-mode: overlay;
pointer-events: none;
animation: gbsweep 2.8s ease-in-out infinite;
}
@keyframes gbsweep {
0% { left: -70%; }
100% { left: 130%; }
}
@media (prefers-reduced-motion: reduce) {
.gbshine-gold::after, .gbshine-platinum::after { display: none; }
}


.gbsim-bar-wrap { position: relative; height: 1.4rem; border-radius: 8px; overflow: hidden; display: flex; border: var(--border1); margin-bottom: .5em; }
.gbsim-bar-seg { height: 100%; }
.gbsim-cursor { position: absolute; top: -4px; width: 3px; height: calc(100% + 8px); background: var(--title); box-shadow: 0 0 6px rgba(0,0,0,.6); transition: left .25s ease; }

.gbsim-slider { width: 100%; margin: .3em 0 1.3em; accent-color: var(--accent1); cursor: pointer; }

.gbsim-effects h4 { margin: 0 0 .6em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; color: var(--accent1); }
.gbsim-effects ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .4em; }
.gbsim-effects li { position: relative; padding-left: 1.4em; font: var(--fs-small) var(--f-body); color: var(--subtitle); line-height: 1.5em; }
.gbsim-effects li::before { content: '\f105'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; left: 0; top: .15em; color: currentColor; font-size: .8em; }

.gbsim-actions { margin-top: 0; padding-top: 0; border-top: 0; }
.gbsim-actions h4 { margin: 0 0 .8em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; color: var(--subtitle); }
.gbsim-actiongrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .6em; }
.gbsimbtn { display: flex; align-items: center; gap: .7em; background: var(--dbckg0); border: var(--border1); padding: .7em 1em; font: var(--fs-small) var(--f-body); color: var(--text); border-radius: 4px; }
.gbsimbtn .gbsimicon { flex-shrink: 0; font-size: .85em; }
.gbsimbtn.positive .gbsimicon { color: #3fae82; }
.gbsimbtn.negative .gbsimicon { color: var(--accent1); }
#gbsimactionswrap { margin: 0; }
.gbsimreset { margin-top: 1.2em; background: transparent; border: 1px dashed var(--text3); color: var(--text2); padding: .55em 1.1em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; cursor: pointer; transition: ease .3s; }
.gbsimreset:hover { color: var(--accent1); border-color: var(--accent2); }

/* Accordéon détaillé des rangs */
.gbrankdetail { margin: 0; }
.gbrankdetail + .gbrankdetail { margin-top: .6em; }
.gbrankdetail summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: .7em; padding: .9em 1.2em; border: var(--border1); background: var(--dbckg1); font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; color: var(--subtitle); }
.gbrankdetail summary::-webkit-details-marker { display: none; }
.gbrankdetail summary::after { content: '\f078'; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-left: auto; font-size: var(--fs-tiny); color: var(--accent1); transition: transform .3s; }
.gbrankdetail[open] summary::after { transform: rotate(180deg); }
.gbrankdetail .gbrankdot { width: .8em; height: .8em; border-radius: 50%; flex-shrink: 0; }
.gbrankdetail-content { padding: 1.1em 1.4em; border: var(--border1); border-top: 0; font: var(--fs-small) var(--f-body); color: var(--text); line-height: 1.65em; }
.gbrankdetail-content ul { margin: 0; padding-left: 1.3em; }
.gbrankdetail-content li { margin-bottom: .5em; }

/* Groupes d'affinité */
.gbgroupsgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.2em; margin: 1.5em 0 2em; }
.gbgroupcard { background: var(--dbckg1); border: var(--border1); border-top: 3px solid var(--card-color, var(--accent1)); border-radius: 4px; padding: 1.3em 1.4em; }
.gbgroupcard-head { display: flex; align-items: center; gap: .6em; margin: 0 0 .8em; }
.gbgroupcard-titles { display: flex; flex-direction: column; gap: .2em; }
.gbgroupcard-dot { width: .9em; height: .9em; border-radius: 50%; flex-shrink: 0; background: var(--card-color, var(--accent1)); box-shadow: 0 0 8px color-mix(in srgb, var(--card-color, var(--accent1)) 60%, transparent); }
.gbgroupcard h4 { margin: 0; font: 700 var(--fs-h6) var(--f-titles); text-transform: uppercase; letter-spacing: .03em; color: var(--card-color, var(--accent1)); }
.gbgroupcard-status { font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; }
.gbgroupcard-status.open { color: #3fae82; }
.gbgroupcard-status.closed { color: var(--accent1); }
.gbgroupcard p { margin: 0; font: var(--fs-small) var(--f-body); color: var(--text); line-height: 1.65em; text-align: justify; }

/* Quiz d'affinité */
.gbquiz { border: var(--border2); background: var(--dbckg1); border-radius: 10px; padding: 1.8em 2em; margin: 2em 0; }
.gbquiz-intro { text-align: center; }
.gbquiz-intro h4 { margin: 0 0 .7em; font: 700 var(--fs-h6) var(--f-titles); text-transform: uppercase; letter-spacing: .03em; color: var(--accent1); }
.gbquiz-intro p { max-width: 32rem; margin: 0 auto 1.3em; font: var(--fs-small) var(--f-body); color: var(--subtitle); line-height: 1.6em; }
.gbquiz-progress { height: .35rem; border-radius: 4px; background: var(--dbckg2); overflow: hidden; margin-bottom: 1.6em; }
.gbquiz-progress-bar { height: 100%; width: 0%; background: linear-gradient(to right, var(--accent2), var(--accent1)); transition: width .3s ease; }
.gbquiz-qnum { margin: 0 0 .5em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--text3); }
.gbquiz-question h4 { margin: 0 0 1.2em; font: 700 var(--fs-h6) var(--f-titles); color: var(--title); line-height: 1.4em; text-transform: none; letter-spacing: normal; }
.gbquiz-options { display: flex; flex-direction: column; gap: .6em; }
.gbquiz-option { display: block; width: 100%; text-align: left; background: var(--dbckg0); border: var(--border1); padding: .8em 1.1em; font: var(--fs-small) var(--f-body); color: var(--text); border-radius: 4px; cursor: pointer; transition: ease .2s; }
.gbquiz-option:hover { border-color: var(--accent2); color: var(--links2); background: var(--dbckg2); }
.gbquiz-result { text-align: center; padding: .5em 0; }
.gbquiz-result-dot { width: 3rem; height: 3rem; border-radius: 50%; margin: 0 auto 1em; background: var(--result-color, var(--accent1)); box-shadow: 0 0 20px color-mix(in srgb, var(--result-color, var(--accent1)) 50%, transparent); }
.gbquiz-result h4 { margin: 0 0 .8em; font: 900 var(--fs-h3) var(--f-titles); text-transform: uppercase; letter-spacing: .04em; color: var(--result-color, var(--accent1)); }
.gbquiz-result p { max-width: 34rem; margin: 0 auto 1.5em; font: var(--fs-small) var(--f-body); color: var(--subtitle); line-height: 1.6em; text-align: center; }

/* Séparateur de méta-catégorie (règlement) */
.gbregcat { display: flex; align-items: center; gap: .9em; margin: 3em 0 1.3em; }
.gbregcat:first-child { margin-top: 0; }
.gbregcat em { color: var(--accent1); font-size: 1.1em; flex-shrink: 0; }
.gbregcat span { font: 700 var(--fs-small) var(--f-mono); text-transform: uppercase; letter-spacing: .18em; color: var(--accent1); flex-shrink: 0; }
.gbregcat::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, var(--accent2), transparent); }

/* ===== Carte illustrée (image + texte, pour illustrer une section) ===== */
.gbfeature { display: flex; gap: 1.5em; align-items: stretch; border: var(--border2); background: var(--dbckg1); border-radius: 8px; padding: 1.4em; margin: 1.8em 0; }
.gbfeature-img { width: 11rem; flex-shrink: 0; border-radius: 6px; overflow: hidden; border: var(--border1); }
.gbfeature-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gbfeature-body { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.gbfeature-body h4 { margin: 0 0 .5em; font: 700 var(--fs-small) var(--f-titles); text-transform: uppercase; letter-spacing: .04em; color: var(--accent1); }
.gbfeature-body p { margin: 0; font: var(--fs-small) var(--f-body); color: var(--text); line-height: 1.6em; text-align: justify; }
.gbfeature.gbfeature-reverse { flex-direction: row-reverse; }
@media (max-width: 40rem) {
.gbfeature { flex-direction: column; }
.gbfeature.gbfeature-reverse { flex-direction: column; }
.gbfeature-img { width: 100%; height: 10rem; }
}

/* Bandeau image pleine largeur au sein d'un texte */
.gbinlinebanner { margin: 1.8em 0; border-radius: 8px; overflow: hidden; border: var(--border1); position: relative; }
.gbinlinebanner img { width: 100%; height: 14rem; object-fit: cover; display: block; filter: saturate(.9) contrast(1.05); }
.gbinlinebanner-caption { padding: .7em 1.1em; background: var(--dbckg1); border-top: var(--border1); font: italic var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--text3); }

/* Grille de vignettes (mosaïque d'images) */
.gbimggrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: .8em; margin: 1.8em 0; }
.gbimggrid figure { margin: 0; border-radius: 6px; overflow: hidden; border: var(--border1); background: var(--dbckg0); }
.gbimggrid img { width: 100%; height: 8rem; object-fit: cover; display: block; }
.gbimggrid figcaption { padding: .5em .7em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .04em; color: var(--text2); text-align: center; }

/* ===== Fiches Staff (dossiers de personnel) ===== */
.gbstaffintro { margin-bottom: 2em; }
.gbstaffgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1.6em; margin: 1.5em 0 2em; }

.gbstaffcard {
position: relative; background: var(--dbckg1); border: var(--border2);
border-radius: 6px; padding: 1.6em 1.6em 1.5em; overflow: visible;
}
.gbstaffcard::before {
content: ''; position: absolute; top: 0; left: 1.6em; right: 1.6em; height: 2px;
background: linear-gradient(to right, var(--accent2), var(--accent1), var(--accent2));
}

.gbstaffhead { display: flex; align-items: flex-start; gap: 1.1em; margin-bottom: 1.1em; }

.gbstaffphoto {
position: relative; width: 5.2rem; height: 5.2rem; flex-shrink: 0;
border-radius: 10px; overflow: hidden; border: 3px solid var(--accent2);
box-shadow: 0 6px 14px rgba(0,0,0,.4); transform: rotate(-3deg);
background: var(--dbckg0);
}
.gbstaffphoto img { width: 100%; height: 100%; object-fit: cover; display: block; }
.gbstaffphoto .gbstaffphoto-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--text3); font-size: 1.4rem; }

.gbstaffnames { flex-grow: 1; min-width: 0; padding-top: .2em; }
.gbstaffnames h4 { margin: 0 0 .35em; font: 700 var(--fs-h6) var(--f-titles); text-transform: uppercase; letter-spacing: .02em; color: var(--title); line-height: 1.1em; }
.gbstaffrole {
display: inline-block; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase; letter-spacing: .08em;
color: var(--accent1); border: 1px solid var(--accent1); border-radius: 3px; padding: .25em .6em;
background: rgba(201,76,76,.1);
}

.gbstaffmsg {
position: relative; font: italic var(--fs-small) var(--f-body); color: var(--subtitle); line-height: 1.6em;
padding: 1em 1.2em; margin: 0 0 1.1em; background: var(--dbckg0); border-left: 3px solid var(--accent2);
text-align: justify;
}
.gbstaffmsg em.gbstaffquote { position: absolute; top: .3em; left: .35em; font-size: 1.3em; color: var(--accent2); opacity: .5; font-style: normal; }

.gbstaffmp {
display: inline-flex; align-items: center; gap: .55em; font: 700 var(--fs-tiny) var(--f-mono);
text-transform: uppercase; letter-spacing: .05em; color: var(--accent1); border: 1px solid var(--accent1);
border-radius: 3px; padding: .55em 1em; margin-bottom: 1.1em; transition: ease .3s;
}
.gbstaffmp:hover { background: var(--accent1); color: var(--dbckg0); }

.gbstaffaccounts { border-top: var(--border1); padding-top: .9em; }
.gbstaffaccounts-label {
display: flex; align-items: center; gap: .5em; font: 700 var(--fs-tiny) var(--f-mono); text-transform: uppercase;
letter-spacing: .08em; color: var(--text3); margin-bottom: .6em;
}
.gbstaffaccounts-label em { color: var(--accent2); }
.gbstaffaccounts-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35em; }
.gbstaffaccounts-list li { position: relative; padding-left: 1.2em; font: var(--fs-small) var(--f-body); color: var(--text); }
.gbstaffaccounts-list li::before { content: '\f105'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; left: 0; top: .1em; color: var(--accent1); font-size: .8em; }
.gbstaffaccounts-list a { color: var(--text); }
.gbstaffaccounts-list a:hover { color: var(--accent1); }

.gbstaffdocnum {
position: absolute; top: -.75em; right: 1.2em; font: 700 var(--fs-tiny) var(--f-mono); letter-spacing: .1em;
color: var(--text3); background: var(--cuerpo); padding: .2em .6em; border: var(--border1); border-radius: 3px;
}

/* Variante compacte pour la page Crédits */
.gbcreditsgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.2em; margin: 1.5em 0; }
.gbcreditcard {
background: var(--dbckg1); border: var(--border1); border-radius: 6px; padding: 1.1em 1.3em;
display: flex; align-items: center; gap: 1em;
}
.gbcreditcard em.gbcrediticon { flex-shrink: 0; width: 2.6rem; height: 2.6rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--dbckg0); border: 1px solid var(--accent2); color: var(--accent1); font-size: 1.1rem; }
