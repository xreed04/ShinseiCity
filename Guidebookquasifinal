<script>
document.addEventListener('DOMContentLoaded', function () {

var guidebook = document.getElementById('guidebook');
if (!guidebook) return;

var catToggles = guidebook.querySelectorAll('.gbcat-toggle');
var links = guidebook.querySelectorAll('.gblink');
var pages = guidebook.querySelectorAll('.gbpage');
var gbmain = guidebook.querySelector('.gbmain');
var progressBar = document.getElementById('gbprogressbar');
var scrollTopBtn = document.getElementById('gbscrolltop');

function updateProgress() {
if (!gbmain || !progressBar) return;
var scrollable = gbmain.scrollHeight - gbmain.clientHeight;
var pct = scrollable > 0 ? (gbmain.scrollTop / scrollable) * 100 : 0;
progressBar.style.width = pct + '%';

if (scrollTopBtn) {
if (gbmain.scrollTop > 200) scrollTopBtn.classList.add('visible');
else scrollTopBtn.classList.remove('visible');
}
}

if (gbmain) {
gbmain.addEventListener('scroll', updateProgress);
}

if (scrollTopBtn && gbmain) {
scrollTopBtn.addEventListener('click', function () {
gbmain.scrollTo({ top: 0, behavior: 'smooth' });
});
}

/* ---- Filtre par tag dans le menu ---- */
var filterCheckbox = document.getElementById('gbfilterimportant');
var gbside = guidebook.querySelector('.gbside');
if (filterCheckbox && gbside) {
filterCheckbox.addEventListener('change', function () {
if (filterCheckbox.checked) {
gbside.classList.add('filter-important');
guidebook.querySelectorAll('.gbcat-item').forEach(function (item) { item.classList.add('open'); });
} else {
gbside.classList.remove('filter-important');
}
});
}

/* ---- Effet machine à écrire sur l'accueil ---- */
function typewriter(el, text, speed) {
el.textContent = '';
el.classList.add('gbtyping');
var i = 0;
function step() {
if (i <= text.length) {
el.textContent = text.slice(0, i);
i++;
setTimeout(step, speed);
} else {
el.classList.remove('gbtyping');
}
}
step();
}

var welcomeText = guidebook.querySelector('#welcome .gbtext');
if (welcomeText) {
var fullText = welcomeText.textContent.trim();
typewriter(welcomeText, fullText, 20);
}

/* ---- Blocs verrouillés par mot de passe (SHA-256 natif du navigateur) ---- */
function gbSha256Hex(message) {
var enc = new TextEncoder().encode(message);
return crypto.subtle.digest('SHA-256', enc).then(function (buf) {
return Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
});
}

function gbBase64ToText(b64) {
return decodeURIComponent(escape(atob(b64.trim())));
}

guidebook.querySelectorAll('.gblocked').forEach(function (block) {
var input = block.querySelector('.gblocked-input');
var button = block.querySelector('.gblocked-submit');
var errorEl = block.querySelector('.gblocked-error');
var content = block.querySelector('.gblocked-content');
var encodedEl = block.querySelector('.gblocked-encoded');
var expectedHash = block.getAttribute('data-hash');

function tryUnlock() {
gbSha256Hex(input.value).then(function (hash) {
if (hash === expectedHash) {
content.innerHTML = gbBase64ToText(encodedEl.textContent);
content.hidden = false;
block.querySelector('.gblocked-form').style.display = 'none';
} else {
errorEl.hidden = false;
input.value = '';
input.focus();
}
});
}

if (button) button.addEventListener('click', tryUnlock);
if (input) input.addEventListener('keydown', function (e) {
if (e.key === 'Enter') tryUnlock();
});
});

/* ---- Surlignage automatique du sommaire pendant le scroll ---- */
var sommaireLinks = guidebook.querySelectorAll('.gbsommaire a');
if (sommaireLinks.length && gbmain && 'IntersectionObserver' in window) {
var sectionMap = {};
sommaireLinks.forEach(function (link) {
var id = link.getAttribute('href').substring(1);
var targetEl = document.getElementById(id);
if (targetEl) sectionMap[id] = link;
});

var sommaireObserver = new IntersectionObserver(function (entries) {
entries.forEach(function (entry) {
var link = sectionMap[entry.target.id];
if (!link || !entry.isIntersecting) return;
sommaireLinks.forEach(function (l) { l.classList.remove('active'); });
link.classList.add('active');
});
}, { root: gbmain, rootMargin: '-15% 0px -70% 0px', threshold: 0 });

Object.keys(sectionMap).forEach(function (id) {
sommaireObserver.observe(document.getElementById(id));
});
}

catToggles.forEach(function (btn) {
btn.addEventListener('click', function () {
var item = btn.closest('.gbcat-item');
item.classList.toggle('open');
});
});

function updateBreadcrumb(categoryName, pageTitle, readTime) {
var el = document.getElementById('gbbreadcrumb');
if (!el) return;
var html = '';
if (!categoryName) {
html = '<span class="gbcrumb-current">Accueil</span>';
} else {
html = categoryName + ' <em class="fa-solid fa-chevron-right"></em> <span class="gbcrumb-current">' + pageTitle + '</span>';
}
if (readTime) {
html += ' <span class="gbreadtime"><em class="fa-solid fa-clock"></em>' + readTime + '</span>';
}
el.innerHTML = html;
}

function showPage(id) {
var target = document.getElementById(id);
if (!target || !target.classList.contains('gbpage')) return;

pages.forEach(function (p) { p.classList.remove('active'); });
target.classList.add('active');

links.forEach(function (l) { l.classList.remove('active'); });
var activeLink = guidebook.querySelector('.gblink[href="#' + id + '"]');
var categoryName = null;

if (activeLink) {
activeLink.classList.add('active');
var parentItem = activeLink.closest('.gbcat-item');
if (parentItem) {
parentItem.classList.add('open');
var catLabel = parentItem.querySelector('.gbcat-toggle span');
if (catLabel) categoryName = catLabel.textContent.trim();
}
}

var titleEl = target.querySelector('.gbheader h2');
var pageTitle = titleEl ? titleEl.textContent.trim() : '';

var textEl = target.querySelector('.gbtext');
var readTime = '';
if (textEl) {
var wordCount = textEl.textContent.trim().split(/\s+/).filter(Boolean).length;
var minutes = Math.max(1, Math.round(wordCount / 200));
readTime = minutes + ' min de lecture';
}

updateBreadcrumb(categoryName, pageTitle, readTime);

if (gbmain) gbmain.scrollTop = 0;
updateProgress();

guidebook.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

links.forEach(function (link) {
link.addEventListener('click', function (e) {
e.preventDefault();
var id = link.getAttribute('href').substring(1);
showPage(id);
history.replaceState(null, '', '#' + id);
});
});

var hash = window.location.hash.substring(1);
if (hash && document.getElementById(hash)) {
showPage(hash);
} else {
var firstCat = guidebook.querySelector('.gbcat-item');
if (firstCat) firstCat.classList.add('open');
updateBreadcrumb(null, '');
}

});
</script>

