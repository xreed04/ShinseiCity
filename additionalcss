/* ============================================================
   SHINSEI CITY — RÉACTIONS SUR POSTS
   Compatible dark / light (hérite des variables du thème)
   Fichier séparé : additionalcss.css sur GitHub
   ============================================================ */

.shinsei-reactions-bar {
  position: absolute;
  right: var(--gap);
  bottom: var(--gap);
  display: flex;
  gap: 1px;
  outline: var(--border1);
  z-index: 3;
  background: var(--dbckg0);
  backdrop-filter: var(--ft-blur);
}

.shinsei-reaction-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.5em;
  border: 0;
  outline: var(--border1);
  background: transparent;
  color: var(--text2);
  font: var(--fset-mono3);
  text-transform: uppercase;
  padding: 0.75em 1em;
  cursor: pointer;
  transition: ease 0.3s;
  line-height: 1em;
}

.shinsei-reaction-btn:hover {
  background: color-mix(in srgb, var(--accent2) 15%, transparent);
  color: var(--links2);
}

.shinsei-reaction-btn.srb-active {
  background: color-mix(in srgb, var(--accent1) 20%, transparent);
  outline-color: var(--accent1);
}

.shinsei-reaction-btn.srb-loading {
  opacity: 0.5;
  pointer-events: none;
}

/* ---------- Emoji (police dédiée, anti-twemoji) ---------- */

.shinsei-reaction-btn .srb-emoji {
  font-family: "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol",
    "Noto Color Emoji", sans-serif;
  font-size: var(--fs-h7);
  opacity: 0.75;
  transition: ease 0.3s;
}

.shinsei-reaction-btn:hover .srb-emoji,
.shinsei-reaction-btn.srb-active .srb-emoji {
  opacity: 1;
}

.shinsei-reaction-btn:hover .srb-emoji {
  transform: scale(1.15);
}

/* ---------- Compteur ---------- */

.shinsei-reaction-btn .srb-count {
  color: var(--subtitle);
  font-weight: 700;
  min-width: 0.8em;
  text-align: center;
  font-size: var(--fs-small);
}

.shinsei-reaction-btn.srb-empty .srb-count {
  color: var(--text3);
}

.shinsei-reaction-btn.srb-active .srb-count {
  color: var(--accent1);
}

/* ---------- Tooltip (liste des pseudos), style aligné sur #s-m-t-tooltip ---------- */

.shinsei-reaction-tooltip {
  display: block;
  position: absolute;
  z-index: 999;
  bottom: calc(100% + 0.5em);
  right: 0;
  max-width: 240px;
  min-width: 80px;
  padding: 0.6em 0.9em;
  background: var(--dbckg0);
  backdrop-filter: var(--ft-blur);
  border: var(--border2);
  font: var(--fset-mono3);
  text-transform: none;
  font-weight: 700;
  line-height: 1.3em;
  color: var(--subtitle);
  opacity: 0;
  visibility: hidden;
  transform: translateY(4px);
  transition: ease 0.25s;
  pointer-events: none;
  text-align: left;
  white-space: normal;
}

.shinsei-reaction-btn:hover .shinsei-reaction-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.shinsei-reaction-btn.srb-empty .shinsei-reaction-tooltip {
  display: none;
}

/* ---------- Ancrage sur le post ---------- */

.shinsei-post-anchor {
  position: relative;
  padding-bottom: calc(var(--gap) * 3.5);
  overflow: visible;
}

/* ---------- Responsive ---------- */

@media (max-width: 55rem) {
  .shinsei-reactions-bar {
    position: static;
    margin: var(--gap);
    align-self: flex-end;
  }

  .shinsei-post-anchor {
    padding-bottom: 0;
  }
}
